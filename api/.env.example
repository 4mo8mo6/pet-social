APP_NAME=Pet Agent Social API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults to false in development and true in production.
AUTH_COOKIE_SECURE=

# DATABASE_URL overrides the Postgres host/port variables below.
# REDIS_URL and REDIS_HOST/REDIS_PORT are reserved for future cache or queue work;
# the current API runtime does not read or write Redis.
DATABASE_URL=
REDIS_URL=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pet_agent_social
POSTGRES_USER=pet_agent
POSTGRES_PASSWORD=pet_agent_password

REDIS_HOST=localhost
REDIS_PORT=6379

SECONDME_API_BASE_URL=https://api.mindverse.com/gate/lab
SECONDME_CLIENT_ID=
SECONDME_CLIENT_SECRET=
SECONDME_REFRESH_ENDPOINT=https://api.mindverse.com/gate/lab/api/oauth/token/refresh

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional image generation backend used for pet avatar rendering.
# Recommended China-based provider example (Zhipu official image API):
# PET_AVATAR_GENERATION_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
# PET_AVATAR_MODEL=glm-image
# PET_AVATAR_IMAGE_SIZE=1280x1280
# PET_AVATAR_IMAGE_QUALITY=hd
# PET_AVATAR_BACKGROUND should usually stay empty for Zhipu.
PET_AVATAR_GENERATION_URL=
PET_AVATAR_API_KEY=
PET_AVATAR_MODEL=
PET_AVATAR_IMAGE_SIZE=
PET_AVATAR_IMAGE_QUALITY=
PET_AVATAR_BACKGROUND=
PET_AVATAR_TIMEOUT_SECONDS=60
PET_AVATAR_MEDIA_ROOT=
PET_AVATAR_PROMPT_SUFFIX=

# Comma-separated HTTPS hosts that external A2A dispatch may call.
# Example: A2A_ALLOWED_HOSTS=agents.example.com,*.trusted-agent.net
A2A_ALLOWED_HOSTS=
